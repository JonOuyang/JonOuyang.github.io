# /schedule — Google Calendar hookup. Copy to .env.local (git-ignored) and fill in.
# Same values go into Vercel → Project → Settings → Environment Variables.

# OAuth client (Google Cloud Console → Google Auth Platform → Clients → Desktop app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Filled in automatically by: node scripts/google-auth.mjs  (sign in with the hub account)
GOOGLE_REFRESH_TOKEN=

# Calendars whose busy times block availability (free/busy only; details are never read).
# The first is the hub (the account you sign in with); the others share free/busy with it.
CALENDAR_IDS=you@school.edu,you@gmail.com,you@work.com
# Where booked events are created ("primary" = the signed-in hub account's calendar)
BOOKING_CALENDAR_ID=primary
# Optional: also invite another of Jonathan's addresses (blank = organizer only)
JONATHAN_INVITE_EMAIL=
